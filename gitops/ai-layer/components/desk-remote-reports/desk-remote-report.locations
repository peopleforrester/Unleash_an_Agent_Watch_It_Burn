# ABOUTME: The public desk's two routes for the other KubeCon cluster (#1157, #1209), its deploy reports and its cluster
# ABOUTME: reads, included into console.conf's support-desk server by the desk-remote-reports component and nowhere else.
#
# The admin cluster's deploy_app posts here, at https://support.burritobot.co/remote-landed, with the token in
# X-Desk-Report-Token. POST only and small, as /landed's reports are. A request without the header is refused here,
# before it reaches the desk; the desk then compares the header with DESK_REPORT_TOKEN and records the report only on
# a match (ticket_site.py, remote_report_allowed). In-cluster /landed stays refused from outside (console.conf).
location = /remote-landed {
  limit_except POST { deny all; }
  client_max_body_size 4k;
  if ($http_x_desk_report_token = "") { return 401; }
  set $wib_c6_desk_remote http://fake-ticket.agent.svc.cluster.local:8080;
  proxy_pass $wib_c6_desk_remote;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_read_timeout 10s;
}

# The admin cluster's reader (#1050) posts what that cluster still runs here, through its desk-relay, with the same
# token (#1209). The desk applies the read only on a token match, and only to the rows it labelled private, so a read
# from either cluster greys that cluster's rows and no other's. A read lists every name of each kind, so it may be as
# large as the desk's MAX_READ_BODY. In-cluster /cluster-read stays refused from outside (console.conf).
location = /remote-cluster-read {
  limit_except POST { deny all; }
  client_max_body_size 512k;
  if ($http_x_desk_report_token = "") { return 401; }
  set $wib_c6_desk_remote_read http://fake-ticket.agent.svc.cluster.local:8080;
  proxy_pass $wib_c6_desk_remote_read;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_read_timeout 10s;
}
