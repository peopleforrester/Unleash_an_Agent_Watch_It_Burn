          {
            "definition": {
              "type": "toplist",
              "title": "Guardrail catches (guard-proxy), by cluster and guard",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "logs",
                      "name": "q",
                      "indexes": [
                        "*"
                      ],
                      "search": {
                        "query": "kube_namespace:agent @event:(input_blocklist_hit OR input_classifier_block OR output_scrub) $cluster"
                      },
                      "compute": {
                        "aggregation": "count"
                      },
                      "group_by": [
                        {
                          "facet": "kube_cluster_name",
                          "limit": 60,
                          "sort": {
                            "aggregation": "count",
                            "order": "desc"
                          }
                        },
                        {
                          "facet": "@event",
                          "limit": 60,
                          "sort": {
                            "aggregation": "count",
                            "order": "desc"
                          }
                        }
                      ]
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q",
                      "limit": {
                        "count": 60,
                        "order": "desc"
                      }
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "Fork bomb triggered, by cluster",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "logs",
                      "name": "q",
                      "indexes": [
                        "*"
                      ],
                      "search": {
                        "query": "kube_namespace:security @rule:\"Fork Bomb In Workload Container\" $cluster"
                      },
                      "compute": {
                        "aggregation": "count"
                      },
                      "group_by": [
                        {
                          "facet": "kube_cluster_name",
