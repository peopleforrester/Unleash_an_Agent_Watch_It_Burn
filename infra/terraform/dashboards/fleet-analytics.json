          {
            "definition": {
              "type": "toplist",
              "title": "Command blocks tapped, by challenge and target",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:witb.lab.calls{span.name:lab.command.send,$cluster,$role} by {witb.lab.challenge,witb.lab.kind}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q",
                      "limit": {
                        "count": 60,
                        "order": "desc"
