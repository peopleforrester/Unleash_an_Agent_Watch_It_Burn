    {
      "definition": {
        "type": "group",
        "title": "What their agents were asked, and what the guardrails caught",
        "layout_type": "ordered",
        "background_color": "vivid_pink",
        "show_title": true,
        "widgets": [
          {
            "definition": {
              "type": "toplist",
              "title": "Messages sent to BurritoBot, by cluster",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q",
                      "query": "sum:traces.span.metrics.calls{service:burritobot,span.name:chat,$cluster} by {kube_cluster_name}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q",
                      "limit": {
                        "count": 60,
                        "order": "desc"
