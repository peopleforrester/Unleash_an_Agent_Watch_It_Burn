+# ABOUTME: Conformance for a /chat turn kagent stops on its ask_user tool: the guest reads the question, not the
+# ABOUTME: scratchpad that is the turn's only text, and no thinking-only retry is sent (Watch_It_Burn#1094).
+from __future__ import annotations
+
+import pytest
+
+from fakes import Reply, verdict
+
+SCRATCH = (
+    "<thinking> I need to recall the last thing Edgar the Mummy asked me. Since I don't have memory of past "
+    "interactions, I'll have to ask him directly. </thinking>\n\n"
+)
+QUESTION = "Edgar the Mummy, could you please remind me what was the last thing you asked me?"
+
+
+def ask_user_task(questions, text=SCRATCH, state="input-required", call_name="ask_user"):
+    """A task in the shape kagent v0.10.1's Go runtime ends an ask_user turn on, as recorded live on
+    watch-it-burn-community on 2026-11-07: the model's text and the ask_user call in the agent history, its
+    pending response, and the adk_request_confirmation call in the status message carrying the original call."""
+    call = {"args": {"questions": questions}, "id": "tooluse_1", "name": call_name}
+    hint = "; ".join(q.get("question", "") for q in questions if isinstance(q, dict))
+    agent_parts = [{"kind": "data", "data": call, "metadata": {"adk_type": "function_call"}}]
+    if text:
+        agent_parts.insert(0, {"kind": "text", "text": text})
+    return {
+        "jsonrpc": "2.0",
+        "id": "chat",
+        "result": {
+            "kind": "task",
+            "id": "task-1094",
+            "contextId": "ctx-1094",
+            "history": [
+                {"role": "user", "parts": [{"kind": "text", "text": "What was the last thing I asked you?"}]},
+                {"role": "agent", "parts": agent_parts},
+                {"role": "agent", "parts": [{"kind": "data", "data": {
+                    "id": "tooluse_1", "name": call_name,
+                    "response": {"questions": questions, "status": "pending"}},
+                    "metadata": {"adk_type": "function_response"}}]},
+            ],
+            "metadata": {"kagent_usage_metadata": {"promptTokenCount": 9802, "candidatesTokenCount": 80}},
+            "status": {
+                "state": state,
+                "message": {"kind": "message", "role": "agent", "parts": [{"kind": "data", "data": {
+                    "args": {"originalFunctionCall": call,
+                             "toolConfirmation": {"confirmed": False, "hint": hint, "payload": None}},
+                    "id": "adk-1", "name": "adk_request_confirmation"},
+                    "metadata": {"adk_is_long_running": True, "adk_type": "function_call"}}]},
+            },
+        },
+    }
+
+
+def test_ask_user_question_is_the_reply(start_proxy, agent):
+    agent.respond = lambda req: Reply(body=ask_user_task([{"question": QUESTION}]))
+    p = start_proxy()
+    body = p.chat("What was the last thing I asked you?").json()
+    # The scratchpad stays, for the chat page to fold away as it folds every one; the question follows it.
+    assert body["reply"] == SCRATCH.strip() + "\n\n" + QUESTION
+    assert body["input_tokens"] == 9802
+    assert len(agent.calls()) == 1, "a question is an answer: no thinking-only retry"
+    events = p.events()
+    assert "thinking_only_retry" not in events
+    assert "thinking_only_surfaced" not in events
+
+
+def test_ask_user_with_no_text_is_the_question_alone(start_proxy, agent):
+    agent.respond = lambda req: Reply(body=ask_user_task([{"question": QUESTION}], text=""))
+    p = start_proxy()
+    assert p.chat("hi").json()["reply"] == QUESTION
+    assert len(agent.calls()) == 1
+
+
+def test_ask_user_choices_and_every_question_in_order(start_proxy, agent):
+    questions = [
+        {"question": "  Which base would you like?  ", "choices": ["Cilantro-Slime Rice", " Graveyard Greens ", ""]},
+        {"question": "Any salsa?", "choices": [], "multiple": True},
+    ]
+    agent.respond = lambda req: Reply(body=ask_user_task(questions))
+    reply = start_proxy().chat("I'd like a burrito").json()["reply"]
+    assert reply == (SCRATCH.strip() + "\n\nWhich base would you like? (Cilantro-Slime Rice, Graveyard Greens)"
+                     "\n\nAny salsa?")
+
+
+def test_ask_user_question_already_in_the_text_is_not_repeated(start_proxy, agent):
+    text = "Sure thing! " + QUESTION
+    agent.respond = lambda req: Reply(body=ask_user_task([{"question": QUESTION}], text=text))
+    assert start_proxy().chat("hi").json()["reply"] == text
+
+
+def test_input_required_for_another_tool_is_left_alone(start_proxy, agent):
+    """Only ask_user's question is the guest's to answer: a confirmation for any other tool adds nothing, and
+    a reasoning-only reply is retried and surfaced as before."""
+    agent.respond = lambda req: Reply(body=ask_user_task([{"question": QUESTION}], call_name="deploy_app"))
+    p = start_proxy()
+    reply = p.chat("hi").json()["reply"]
+    assert QUESTION not in reply
+    assert len(agent.calls()) == 2
+    assert "thinking_only_surfaced" in p.events()
+
+
+def test_a_finished_task_adds_no_question(start_proxy, agent):
+    agent.respond = lambda req: Reply(body=ask_user_task([{"question": QUESTION}], state="completed"))
+    p = start_proxy()
+    assert QUESTION not in p.chat("hi").json()["reply"]
+    assert "thinking_only_surfaced" in p.events()
+
+
+@pytest.mark.parametrize(
+    "mangle",
+    [
+        lambda s: s.update(message={"parts": "not a list"}),
+        lambda s: s.update(message="not a dict"),
+        lambda s: s["message"]["parts"][0].update(data="not a dict"),
+        lambda s: s["message"]["parts"][0].update(kind="text"),
+        lambda s: s["message"]["parts"][0]["data"].update(args="not a dict"),
+        lambda s: s["message"]["parts"][0]["data"]["args"].update(originalFunctionCall=None),
+        lambda s: s["message"]["parts"][0]["data"]["args"]["originalFunctionCall"].update(args=None),
+        lambda s: s["message"]["parts"][0]["data"]["args"]["originalFunctionCall"]["args"].update(questions="x"),
+        lambda s: s["message"]["parts"][0]["data"]["args"]["originalFunctionCall"]["args"].update(
+            questions=[None, "a string", {"question": 7}, {"question": "   "}]),
+    ],
+)
+def test_odd_ask_user_shapes_fall_back_to_the_text(start_proxy, agent, mangle):
+    body = ask_user_task([{"question": QUESTION}])
+    mangle(body["result"]["status"])
+    agent.respond = lambda req: Reply(body=body)
+    p = start_proxy()
+    r = p.chat("hi")
+    assert r.status == 200
+    assert QUESTION not in r.json()["reply"]
+    assert "thinking_only_surfaced" in p.events()
+
+
+def test_output_guard_reads_the_question(start_proxy, agent, guard):
+    """The question is the model's output like any reply, so the output guard scans and can redact it."""
+    agent.respond = lambda req: Reply(body=ask_user_task([{"question": "Is the code OPHELIA?"}], text=""))
+    guard.respond = lambda req: Reply(body=verdict(False, "Is the code [REDACTED]?", output=True))
+    p = start_proxy(OUTPUT_GUARD="on")
+    body = p.chat("hi").json()
+    assert body["reply"] == "Is the code [REDACTED]?"
+    assert body["guarded"] is True
+    assert guard.calls("/analyze/output")[0].json()["output"] == "Is the code OPHELIA?"
