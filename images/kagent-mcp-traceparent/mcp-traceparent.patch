+// traceContextRoundTripper injects the globally configured propagator's fields
+// (traceparent and tracestate, and baggage when the context carries members) for
+// the request's active span. A request whose context has no valid span is sent
+// unchanged, so a header set by an outer layer survives.
+type traceContextRoundTripper struct {
+	base http.RoundTripper
+}
+
+func (rt *traceContextRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
+	if !trace.SpanContextFromContext(req.Context()).IsValid() {
+		return rt.base.RoundTrip(req)
+	}
+	req = req.Clone(req.Context())
+	otel.GetTextMapPropagator().Inject(req.Context(), propagation.HeaderCarrier(req.Header))
+	return rt.base.RoundTrip(req)
+}
