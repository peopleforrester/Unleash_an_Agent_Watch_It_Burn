# Imported context archive from a separate pilot run — not part of this build, AI-named.
claude-ai-context/

# Secrets — never commit (symlinked into ~/secrets per env-vault convention).
.env
*.env

# Python / tooling
__pycache__/
*.pyc
.DS_Store

# Local scratch
/tmp/
*.b64

# Override global gitignore — prds/ is tracked in this repo
!prds/

# Real per-attendee AWS keys generated by scripts/generate_attendee_aws.py (never commit)
aws-pool*.csv
verify/.feedback/
.fleet-hooks-test.*/

# Per-machine Claude Code settings (a remote environment id, not shareable state).
# .claude/settings.json IS tracked: it carries this repo's deliberate model pin.
.claude/settings.local.json

# Post-event harvest: raw per-cluster behavioural data, may contain attendee-typed text.
# Never committed: analysis products are summarised into docs/ by hand.
.harvest/
